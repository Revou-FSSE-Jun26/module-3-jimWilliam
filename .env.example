# ─── RevoTech environment ────────────────────────────────────────────────────
# Copy to .env.local and edit. .env.local is gitignored; this file is committed
# and must never hold a real secret.

# ─── This app (Next.js) ──────────────────────────────────────────────────────
# Where the frontend sends its HTTP API calls - NOT a database URL. "/api" is
# the mock of the Module 2 Flask API that ships inside this app. To call the
# real Flask deployment instead (its routes sit at the root, no /api prefix):
#   NEXT_PUBLIC_API_BASE_URL=https://revou-revoshop-jim1504-seven.vercel.app
# A PostgreSQL/Supabase connection string never goes here: it is a secret, and
# anything prefixed NEXT_PUBLIC_ is compiled into the browser bundle. It
# belongs in DATABASE_URL, below, and is read only on the server.
NEXT_PUBLIC_API_BASE_URL=/api

# Sent as x-api-key on server-side fetches. Server-only — never give a secret
# the NEXT_PUBLIC_ prefix, or it ends up in the browser bundle.
API_SECRET_KEY=dev-only-change-me

# Database. Unset = the in-memory catalogue (resets on restart; what `npm run
# dev` and the Playwright tests use). Set = PostgreSQL, created and seeded once
# with `npm run db:setup`. Plain postgresql:// - no "+psycopg" driver part.
#   local:    postgresql://postgres:postgres@localhost:5432/revotech
#   Supabase: Project → Connect → "Transaction pooler" (port 6543) for Vercel:
#             postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#             and the "Session pooler" (same URL, port 5432) for `npm run db:setup`.
# DATABASE_URL=

# Product image uploads. Unset = saved in .data/uploads (development). Set =
# Vercel Blob (Vercel → Storage → Blob → connect to the project, which adds
# this variable for you). Only the three converted AVIFs are stored; the
# original upload is never kept, and unused uploads are deleted.
# BLOB_READ_WRITE_TOKEN=

# Optional. Uncomment and restart `npm run dev`:
# MOCK_API_LATENCY_MS=1500        delay every response  → shows loading.tsx skeletons
# MOCK_API_DOWN=1                 answer 503 everywhere → shows error.tsx boundaries
# UPLOAD_ORPHAN_GRACE_MINUTES=60  delete unused product uploads after this long
# PORT=8100                       dev/start port (npm scripts already pass 8100)

# ─── Module 2 backend: Flask + PostgreSQL ────────────────────────────────────
# Not read by this app. Copy these into the Module 2 project's .env — and use
# the same host/port/database/user/password in DBeaver to browse the data.
# (README → "Database access (DBeaver)".) For Supabase: host
# db.<project-ref>.supabase.co (or the session pooler host), port 5432,
# database postgres, user postgres, SSL required.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=revotech
POSTGRES_USER=revotech
POSTGRES_PASSWORD=change-me

# SQLAlchemy takes the whole connection as one URL. The part after the "+" is
# the driver: psycopg = psycopg 3, psycopg2 = the older one. On a managed host
# (Render, Supabase, Neon) append ?sslmode=require. If the Flask app reads
# DATABASE_URL instead, set it there to this same value - not here, where
# DATABASE_URL is this app's plain postgresql:// URL (above).
SQLALCHEMY_DATABASE_URI=postgresql+psycopg://revotech:change-me@localhost:5432/revotech
SQLALCHEMY_TRACK_MODIFICATIONS=False
SQLALCHEMY_ECHO=False
SQLALCHEMY_POOL_SIZE=5
SQLALCHEMY_POOL_RECYCLE=280

# Flask
FLASK_APP=app.py
FLASK_DEBUG=1
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me
JWT_ACCESS_TOKEN_EXPIRES=3600

# Gunicorn — production server:
#   gunicorn --bind $GUNICORN_BIND --workers $GUNICORN_WORKERS "app:create_app()"
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
GUNICORN_LOG_LEVEL=info
